# Bash and zsh, set up to look and work the same. Imported by home.nix.
#
# What's shared (written once, applied to both shells):
#   home.shellAliases       every alias
#   home.sessionVariables   environment (editor, pager, ...)
#   programs.*              starship prompt, zoxide (as `cd`), fzf, direnv, ...
#                           each comes with its own bash + zsh integration
#   sharedInit              plain-shell code both rc files run
#   shell/functions.sh      shell functions (works in both)
#
# What each shell adds to reach the same features:
#   zsh   zsh-autosuggestions, zsh-syntax-highlighting, history substring search
#   bash  ble.sh (autosuggestions, syntax highlighting, menu completion)
# Both are themed with the same Catppuccin Mocha colors as tmux and Neovim.
#
# Machine-specific additions that shouldn't be in git go in ~/.shellrc.local
# (both shells), ~/.bashrc.local or ~/.zshrc.local.
{
  config,
  lib,
  pkgs,
  dotfiles,
  ...
}:
let
  # Catppuccin Mocha, the palette of tmux/tmux.conf and the Neovim colorscheme
  c = {
    red = "#f38ba8";
    peach = "#fab387";
    yellow = "#f9e2af";
    green = "#a6e3a1";
    teal = "#94e2d5";
    sapphire = "#74c7ec";
    blue = "#89b4fa";
    lavender = "#b4befe";
    mauve = "#cba6f7";
    pink = "#f5c2e7";
    text = "#cdd6f4";
    subtext0 = "#a6adc8";
    overlay0 = "#6c7086";
    surface2 = "#585b70";
    surface1 = "#45475a";
    surface0 = "#313244";
    base = "#1e1e2e";
    mantle = "#181825";
    crust = "#11111b";
  };

  # Load Nix in shells that start without it (non-NixOS; most installs do this
  # system-wide already, single-user ones only via ~/.profile).
  nixLoader = ''
    if ! command -v nix >/dev/null 2>&1; then
      for f in /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
        if [ -r "$f" ]; then . "$f"; break; fi
      done
    fi
  '';

  # Run by both interactive shells, early (before completion setup)
  sharedInit = ''
    # ── Shared by bash and zsh (shell/default.nix) ──
    # ls/eza/completion colors: Catppuccin Mocha, generated by vivid
    [ -r "''${XDG_CONFIG_HOME:-$HOME/.config}/shell/ls-colors" ] && export LS_COLORS="$(cat "''${XDG_CONFIG_HOME:-$HOME/.config}/shell/ls-colors")"
    # Shell functions: live from the repo, so edits apply to new shells without a switch
    [ -r "${dotfiles}/shell/functions.sh" ] && . "${dotfiles}/shell/functions.sh"
  '';

  # Run by both, last: machine-local additions (not in git)
  localInit = shell: ''
    [ -r "$HOME/.shellrc.local" ] && . "$HOME/.shellrc.local"
    [ -r "$HOME/.${shell}rc.local" ] && . "$HOME/.${shell}rc.local"
  '';

  # Syntax highlighting colors, the same for both shells:
  # zsh-syntax-highlighting style names -> ble.sh face names
  syntax = {
    command = c.green;
    option = c.peach;
    string = c.yellow;
    comment = c.surface2;
    separator = c.red;
    error = c.red;
    path = c.text;
    variable = c.mauve;
    suggestion = c.overlay0;
  };
in
{
  home.packages = with pkgs; [
    bashInteractive # a current bash (macOS ships 3.2)
    eza # ls
    jq
    vivid # LS_COLORS generator
  ];

  home.sessionPath = [ "$HOME/.local/bin" ];

  home.sessionVariables = {
    EDITOR = "nvim";
    VISUAL = "nvim";
    MANPAGER = "nvim +Man!"; # man pages in Neovim, same theme
    LESS = "-R --mouse";
  };

  # ── Aliases (both shells) ───────────────────────────────────────────────────
  home.shellAliases = {
    # ls -> eza (colors from LS_COLORS)
    ls = "eza --group-directories-first";
    ll = "eza -l --git --group-directories-first --time-style=relative";
    la = "eza -la --git --group-directories-first --time-style=relative";
    lt = "eza --tree --level=2 --group-directories-first";

    # cd is zoxide (see programs.zoxide): `cd foo` jumps to the best match for
    # "foo" among directories you've visited; `cdi` picks one with fzf
    ".." = "cd ..";
    "..." = "cd ../..";
    "...." = "cd ../../..";

    v = "nvim";
    vi = "nvim";
    vim = "nvim";
    cat = "bat --paging=never --style=plain"; # acts like plain cat when piped
    grep = "grep --color=auto";
    diff = "diff --color=auto";
    mkdir = "mkdir -p";
    cp = "cp -i";
    mv = "mv -i";

    g = "git";
    gs = "git status -sb";
    ga = "git add";
    gc = "git commit";
    gd = "git diff";
    gds = "git diff --staged";
    gl = "git pull";
    gp = "git push";
    gsw = "git switch";
    glog = "git log --oneline --graph --decorate -20";

    t = "tmux new-session -A -s main"; # attach to "main", or create it
    dots = "cd ${dotfiles}";
    dots-switch = "${dotfiles}/switch.sh";
    reload = "exec \"$SHELL\" -l"; # restart the shell (picks up a switch)
    path = "echo \"$PATH\" | tr : '\\n'";
  };

  xdg.configFile."shell/ls-colors".source =
    pkgs.runCommand "ls-colors-catppuccin-mocha" { }
      "${pkgs.vivid}/bin/vivid generate catppuccin-mocha > $out";

  # ── Prompt (both shells): starship ──────────────────────────────────────────
  # Layout after a powerlevel10k single-line prompt, drawn in the tmux bar's
  # style (shade-block fades, Catppuccin; no Nerd Font needed):
  #
  #   ░▒▓ ubuntu ▓▒░ ~/pr/dotfiles ▓▒░ ░▒▓ ◇ main +1 ▓▒░ █        ✘ ERROR 3s ░▒▓ me@host ▓▒░ ░▒▓ 03:52:03 AM ▓▒░
  #   └ left: OS, directory, git            cursor ┘   right: exit status, duration, tools, user@host (SSH), time
  #
  # After you run a command, its prompt collapses to just ❯ ("transient
  # prompt", set up per shell below), so scrollback stays clean.
  programs.starship = {
    enable = true;
    settings = {
      palette = "catppuccin_mocha";
      palettes.catppuccin_mocha = lib.mapAttrs (_: v: v) c;
      add_newline = false;

      format = lib.concatStrings [
        # OS fading into the directory, like tmux's blue → sapphire fade
        "[░▒▓](fg:sapphire)$os[▓▒░](fg:sapphire bg:blue)$directory[▓▒░ ](fg:blue)"
        # Git block, only inside a repo
        "([░▒▓](fg:surface0)$git_branch$git_state$git_status[ ▓▒░](fg:surface0) )"
      ];
      right_format = lib.concatStrings [
        "$status$cmd_duration$jobs"
        "$direnv$nix_shell$python$nodejs$rust$golang"
        # user@host block, only over SSH or as root
        "([░▒▓](fg:surface0)$username$hostname[▓▒░ ](fg:surface0))"
        "[░▒▓](fg:sapphire)$time[▓▒░](fg:sapphire)"
      ];

      os = {
        disabled = false;
        format = "[ $symbol ]($style)";
        style = "bg:sapphire fg:crust bold";
        # Plain names instead of the default emoji/Nerd Font icons
        symbols = {
          Alpine = "alpine";
          Arch = "arch";
          Debian = "debian";
          EndeavourOS = "endeavour";
          Fedora = "fedora";
          Linux = "linux";
          Macos = "macos";
          Manjaro = "manjaro";
          Mint = "mint";
          NixOS = "nixos";
          openSUSE = "suse";
          Pop = "pop";
          Raspbian = "raspbian";
          RedHatEnterprise = "rhel";
          Ubuntu = "ubuntu";
          Unknown = "unix";
          Windows = "windows";
        };
      };

      # ~/pr/dotfiles: parent directories shortened, like p10k
      directory = {
        format = "[ $path$read_only ]($style)";
        style = "bg:blue fg:crust bold";
        read_only = " ◆";
        read_only_style = "bg:blue fg:crust";
        truncation_length = 1;
        fish_style_pwd_dir_length = 2;
        truncate_to_repo = false;
      };

      # ◇ like tmux's normal-mode marker; counts like p10k (+1 staged, !2 modified)
      git_branch = {
        format = "[ ◇ $branch]($style)";
        style = "bg:surface0 fg:text";
      };
      git_state = {
        format = "[ $state( $progress_current/$progress_total)]($style)";
        style = "bg:surface0 fg:peach bold";
      };
      git_status = {
        format = "[( $all_status$ahead_behind)]($style)";
        style = "bg:surface0 fg:yellow";
        ahead = "⇡$count";
        behind = "⇣$count";
        diverged = "⇡$ahead_count⇣$behind_count";
        staged = "+$count";
        modified = "!$count";
        untracked = "?$count";
        deleted = "✗$count";
        renamed = "»$count";
        stashed = "≡";
        conflicted = "=$count";
      };

      # ✔ / ✘ 1 (p10k's status segment)
      status = {
        disabled = false;
        # ✘ ERROR / ✘ NOTFOUND / ✘ INT (Ctrl+C) / ✘ 3 (codes without a name)
        format = "[$symbol( $common_meaning)( $signal_name)( $maybe_int)]($style) ";
        symbol = "✘";
        success_symbol = "✔";
        not_executable_symbol = "✘";
        not_found_symbol = "✘";
        sigint_symbol = "✘";
        signal_symbol = "✘";
        style = "fg:red bold";
        success_style = "fg:green";
        map_symbol = false;
        pipestatus = true;
        pipestatus_format = "[$pipestatus]($style) ";
        pipestatus_separator = "[|](fg:overlay0)";
        pipestatus_segment_format = "[$symbol]($style)";
      };
      cmd_duration = {
        format = "[$duration]($style) ";
        style = "fg:peach";
        min_time = 3000; # p10k threshold: 3s
      };
      jobs = {
        format = "[$symbol$number]($style) ";
        symbol = "&";
        style = "fg:lavender";
      };

      # Environments / tool versions (only where relevant), plain-text labels
      direnv = {
        disabled = false;
        format = "[$loaded]($style) ";
        loaded_msg = "direnv";
        unloaded_msg = "";
        allowed_msg = "";
        not_allowed_msg = "direnv ✘";
        denied_msg = "direnv ✘";
        style = "fg:teal";
      };
      nix_shell = {
        format = "[◈ $name]($style) ";
        style = "fg:sapphire";
        # (not `heuristic`: it counts any /nix/store path on PATH as a nix
        # shell, which with Home Manager is always true)
      };
      python = {
        format = "[py $version( \\($virtualenv\\))]($style) ";
        style = "fg:yellow";
      };
      nodejs = {
        format = "[node $version]($style) ";
        style = "fg:green";
      };
      rust = {
        format = "[rs $version]($style) ";
        style = "fg:peach";
      };
      golang = {
        format = "[go $version]($style) ";
        style = "fg:sapphire";
      };

      username = {
        format = "[ $user]($style)";
        style_user = "bg:surface0 fg:sapphire";
        style_root = "bg:surface0 fg:red bold";
      };
      hostname = {
        format = "[@$hostname ]($style)";
        style = "bg:surface0 fg:sapphire";
      };

      # 12-hour clock like p10k, in tmux's time-segment colors
      time = {
        disabled = false;
        format = "[ $time ]($style)";
        time_format = "%I:%M:%S %p";
        style = "bg:sapphire fg:crust bold";
      };

      # Only used for the collapsed (transient) prompt of finished commands
      character = {
        format = "$symbol ";
        success_symbol = "[❯](bold blue)";
        error_symbol = "[❯](bold red)";
      };
    };
  };

  # ── Shared tools (each wires itself into both shells) ───────────────────────
  programs.zoxide = {
    enable = true;
    options = [
      "--cmd"
      "cd"
    ]; # replaces cd (and adds cdi)
  };

  programs.fzf = {
    enable = true;
    # bash gets fzf through ble.sh's integration instead (see below)
    enableBashIntegration = false;
    defaultCommand = "fd --type f --hidden --exclude .git";
    fileWidgetCommand = "fd --type f --hidden --exclude .git";
    fileWidgetOptions = [ "--preview 'bat --color=always --style=numbers --line-range=:300 {}'" ];
    changeDirWidgetCommand = "fd --type d --hidden --exclude .git";
    changeDirWidgetOptions = [ "--preview 'eza --tree --level=2 --color=always {}'" ];
    defaultOptions = [
      "--height=40%"
      "--layout=reverse"
      "--border=rounded"
      "--info=inline-right"
      "--prompt='❯ '"
      "--pointer='◆'"
      "--marker='◇'"
    ];
    colors = {
      bg = "-1"; # terminal background, like tmux
      "bg+" = c.surface0;
      fg = c.text;
      "fg+" = c.text;
      hl = c.blue;
      "hl+" = c.blue;
      info = c.overlay0;
      prompt = c.blue;
      pointer = c.blue;
      marker = c.sapphire;
      spinner = c.sapphire;
      header = c.sapphire;
      border = c.surface1;
      label = c.subtext0;
      gutter = "-1";
    };
  };

  programs.bat = {
    enable = true;
    config = {
      theme = "Catppuccin Mocha";
      style = "numbers,changes,header";
    };
  };

  # Git diffs/logs with syntax highlighting, same theme
  programs.git.enable = true;
  programs.delta = {
    enable = true;
    enableGitIntegration = true;
    options = {
      syntax-theme = "Catppuccin Mocha";
      navigate = true; # n/N between files
      line-numbers = true;
      file-style = "bold ${c.blue}";
      hunk-header-style = "file line-number syntax";
      hunk-header-decoration-style = c.surface1;
      line-numbers-left-style = c.surface2;
      line-numbers-right-style = c.surface2;
      line-numbers-minus-style = c.red;
      line-numbers-plus-style = c.green;
      minus-style = "syntax #3c2a37";
      plus-style = "syntax #2b3b35";
    };
  };

  # Per-project environments: a .envrc with `use flake` loads that project's
  # Nix dev shell when you cd in
  programs.direnv = {
    enable = true;
    nix-direnv.enable = true;
    config.global.hide_env_diff = true;
  };

  programs.tealdeer = {
    enable = true; # `tldr tar`: short, example-first man pages
    settings.updates.auto_update = true;
  };

  programs.btop = {
    enable = true;
    settings.theme_background = false; # terminal background, like tmux
  };

  # ── zsh ─────────────────────────────────────────────────────────────────────
  programs.zsh = {
    enable = true;
    enableCompletion = true;
    autocd = true; # type a directory name to cd into it (bash: shopt autocd)
    defaultKeymap = "emacs";

    history = {
      size = 100000;
      save = 100000;
      ignoreAllDups = true;
      ignoreSpace = true; # " cmd" isn't saved
      share = true; # shared between open shells (bash: ble.sh history_share)
      extended = true;
    };

    autosuggestion = {
      enable = true;
      highlight = "fg=${syntax.suggestion}";
      strategy = [
        "history"
        "completion"
      ];
    };

    # Up/Down search history for what's typed so far (bash: ble.sh, below)
    historySubstringSearch = {
      enable = true;
      searchUpKey = [
        "^[[A"
        "^[OA"
      ];
      searchDownKey = [
        "^[[B"
        "^[OB"
      ];
    };

    syntaxHighlighting = {
      enable = true;
      styles = {
        default = "fg=${c.text}";
        unknown-token = "fg=${syntax.error}";
        reserved-word = "fg=${syntax.command}";
        alias = "fg=${syntax.command}";
        suffix-alias = "fg=${syntax.command}";
        global-alias = "fg=${syntax.command}";
        builtin = "fg=${syntax.command}";
        function = "fg=${syntax.command}";
        command = "fg=${syntax.command}";
        hashed-command = "fg=${syntax.command}";
        precommand = "fg=${syntax.command},italic";
        autodirectory = "fg=${syntax.path},underline";
        commandseparator = "fg=${syntax.separator}";
        path = "fg=${syntax.path},underline";
        path_prefix = "fg=${syntax.path},underline";
        globbing = "fg=${c.pink}";
        history-expansion = "fg=${c.mauve}";
        single-hyphen-option = "fg=${syntax.option}";
        double-hyphen-option = "fg=${syntax.option}";
        single-quoted-argument = "fg=${syntax.string}";
        double-quoted-argument = "fg=${syntax.string}";
        dollar-quoted-argument = "fg=${syntax.string}";
        back-quoted-argument = "fg=${c.mauve}";
        dollar-double-quoted-argument = "fg=${syntax.variable}";
        assign = "fg=${c.text}";
        redirection = "fg=${c.pink}";
        comment = "fg=${syntax.comment}";
        arg0 = "fg=${syntax.command}";
      };
    };

    envExtra = nixLoader;

    initContent = lib.mkMerge [
      (lib.mkOrder 500 sharedInit) # before compinit (570): LS_COLORS for list-colors
      ''
        # Completion menu: arrow keys to pick, case-insensitive, colored like ls
        zmodload zsh/complist
        zstyle ':completion:*' menu select
        zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
        zstyle ':completion:*' list-colors "''${(s.:.)LS_COLORS}"
        zstyle ':completion:*' group-name '''
        zstyle ':completion:*:descriptions' format '%F{${c.blue}}── %d%f'
        zstyle ':completion:*:warnings' format '%F{${c.red}}no matches%f'
        zstyle ':completion:*' squeeze-slashes true
        bindkey -M menuselect '^[[Z' reverse-menu-complete # Shift+Tab

        HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg=${c.surface0},fg=${c.blue},bold'
        HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='fg=${c.red},bold'
        HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1

        setopt auto_pushd pushd_ignore_dups pushd_silent # cd -<Tab> lists recent dirs
        setopt interactive_comments no_beep
        # Ctrl+W / Alt+Backspace stop at / . - like bash's
        WORDCHARS=''${WORDCHARS//[\/.-]/}

        # Keys bash (readline/ble.sh) has by default
        bindkey '^[[1;5C' forward-word      # Ctrl+Right
        bindkey '^[[1;5D' backward-word     # Ctrl+Left
        bindkey '^[[H' beginning-of-line    # Home
        bindkey '^[[F' end-of-line          # End
        bindkey '^[[3~' delete-char         # Delete
        bindkey '^[[3;5~' kill-word         # Ctrl+Delete
        bindkey '^H' backward-kill-word     # Ctrl+Backspace
        autoload -U edit-command-line && zle -N edit-command-line
        bindkey '^X^E' edit-command-line    # Ctrl+X Ctrl+E: edit the line in nvim
      ''
      (lib.mkOrder 1600 ''
        # Transient prompt (like powerlevel10k): when you press Enter, the
        # prompt of that line collapses to ❯, so scrollback stays clean
        # Right prompt flush with the edge, as in bash (zsh keeps 1 column free)
        ZLE_RPROMPT_INDENT=0
        if [[ $TERM != dumb ]]; then
          typeset -g _dots_prompt=$PROMPT _dots_rprompt=$RPROMPT
          _dots_transient_prompt() {
            PROMPT='%B%(?.%F{${c.blue}}.%F{${c.red}})❯%f%b '
            RPROMPT=
            zle .reset-prompt
          }
          _dots_full_prompt() { PROMPT=$_dots_prompt RPROMPT=$_dots_rprompt; }
          autoload -Uz add-zle-hook-widget add-zsh-hook
          add-zle-hook-widget zle-line-finish _dots_transient_prompt
          add-zsh-hook precmd _dots_full_prompt
        fi
      '')
      (lib.mkOrder 2500 (localInit "zsh"))
    ];
  };

  # ── bash ────────────────────────────────────────────────────────────────────
  programs.bash = {
    enable = true;
    enableCompletion = true;
    historySize = 100000;
    historyFileSize = 100000;
    historyControl = [
      "ignoreboth" # " cmd" isn't saved, nor repeats
      "erasedups"
    ];
    shellOptions = [
      "histappend"
      "checkwinsize"
      "extglob"
      "globstar" # ** matches across directories
      "checkjobs"
      "autocd" # type a directory name to cd into it (zsh: autocd)
      "cdspell"
      "dirspell"
      "no_empty_cmd_completion"
    ];

    # Before the interactive-only part: also for `ssh host cmd`
    bashrcExtra = nixLoader;

    initExtra = lib.mkMerge [
      # ble.sh: the line editor that gives bash zsh's autosuggestions, syntax
      # highlighting and menu completion. Loaded first, attached last.
      (lib.mkOrder 100 ''
        if [[ $- == *i* && $TERM != dumb ]]; then
          # ble.sh only uses ~/.cache and ~/.local/state if they exist already
          # (else it tries its own read-only directory in /nix/store and fails)
          mkdir -p "''${XDG_CACHE_HOME:-$HOME/.cache}" "''${XDG_STATE_HOME:-$HOME/.local/state}"
          source "${pkgs.blesh}/share/blesh/ble.sh" --noattach
        fi
      '')
      (lib.mkOrder 150 sharedInit)
      ''
        if [[ ''${BLE_VERSION-} ]]; then
          # Quiet, like zsh: no "[ble: exit 1]" / elapsed-time marks (starship
          # shows the time), no bell
          bleopt exec_errexit_mark= exec_elapsed_mark= edit_abell= edit_vbell=
          bleopt complete_auto_delay=50
          bleopt history_share=1 # shared between open shells (zsh: share_history)
          bleopt prompt_eol_mark=
          # Transient prompt (like powerlevel10k): when you press Enter, the
          # prompt of that line collapses to ❯ (red after a failed command)
          bleopt prompt_ps1_final='$(${config.programs.starship.package}/bin/starship module character --status="$?")'
          bleopt prompt_rps1_final= prompt_rps1_transient=1 # and drop its right side

          # Same colors as zsh-syntax-highlighting (see `syntax` in shell/default.nix)
          ble-face -s syntax_default         fg=${c.text}
          ble-face -s command_builtin        fg=${syntax.command}
          ble-face -s command_alias          fg=${syntax.command}
          ble-face -s command_function       fg=${syntax.command}
          ble-face -s command_file           fg=${syntax.command}
          ble-face -s command_keyword        fg=${syntax.command}
          ble-face -s command_jobs           fg=${syntax.command}
          ble-face -s command_directory      fg=${syntax.path},underline
          ble-face -s syntax_command         fg=${syntax.command}
          ble-face -s syntax_function_name   fg=${syntax.command}
          ble-face -s argument_option        fg=${syntax.option}
          ble-face -s argument_error         fg=${syntax.error}
          ble-face -s syntax_quoted          fg=${syntax.string}
          ble-face -s syntax_quotation       fg=${syntax.string}
          ble-face -s syntax_escape          fg=${c.pink}
          ble-face -s syntax_param_expansion fg=${syntax.variable}
          ble-face -s syntax_varname         fg=${syntax.variable}
          ble-face -s syntax_expr            fg=${c.mauve}
          ble-face -s syntax_delimiter       fg=${syntax.separator}
          ble-face -s syntax_glob            fg=${c.pink}
          ble-face -s syntax_brace           fg=${c.pink}
          ble-face -s syntax_tilde           fg=${c.text}
          ble-face -s syntax_history_expansion fg=${c.mauve}
          ble-face -s syntax_comment         fg=${syntax.comment}
          ble-face -s syntax_error           fg=${syntax.error}
          ble-face -s filename_directory     fg=${syntax.path},underline
          ble-face -s filename_link          fg=${c.teal},underline
          ble-face -s filename_executable    fg=${syntax.command},underline
          ble-face -s filename_other         fg=${syntax.path},underline
          ble-face -s varname_unset          fg=${c.overlay0}
          ble-face -s auto_complete          fg=${syntax.suggestion}
          ble-face -s region                 bg=${c.surface1}
          ble-face -s region_target          bg=${c.surface0},fg=${c.blue}
          ble-face -s region_match           bg=${c.surface0},fg=${c.blue},bold

          # Up/Down search history for what's typed so far (zsh: history-substring-search)
          ble-bind -m emacs -f up   'history-search-backward hide-status:immediate-accept:empty=history-prev:point=end'
          ble-bind -m emacs -f down 'history-search-forward hide-status:immediate-accept:empty=history-next:point=end'
          ble-bind -m emacs -f C-x,C-e 'edit-and-execute-command' # edit the line in nvim, like zsh

          # fzf: Ctrl+R history, Ctrl+T files, Alt+C directories, ** completion
          _ble_contrib_fzf_base=${pkgs.fzf}/share/fzf
          ble-import -d integration/fzf-completion
          ble-import -d integration/fzf-key-bindings
          ble-import -d integration/zoxide
        else
          # No ble.sh (dumb terminal): plain fzf bindings
          command -v fzf >/dev/null && eval "$(fzf --bash)"
        fi
      ''
      (lib.mkOrder 2500 (localInit "bash"))
      (lib.mkOrder 3000 ''
        [[ ''${BLE_VERSION-} ]] && ble-attach
      '')
    ];
  };
}
